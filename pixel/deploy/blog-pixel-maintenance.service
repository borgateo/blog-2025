[Unit]
Description=borgateo.com pixel: 13-month retention and monthly DB-IP refresh
RequiresMountsFor=/mnt/nas/services/blog-pixel/data

[Service]
Type=oneshot
User=blog-pixel
Group=blog-pixel
WorkingDirectory=/opt/blog-pixel
Environment=PIXEL_DATA_DIR=/mnt/nas/services/blog-pixel/data
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/blog-pixel/maintenance.sh

# Same isolation as the server. Internet is allowed: it downloads DB-IP once a month.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/mnt/nas/services/blog-pixel/data
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=512M
CPUQuota=50%
